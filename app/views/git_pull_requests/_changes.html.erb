<hr>
<div class="pull-request-changes">
<p><strong>Changes</strong>
<% if pr.branch.present? %>
  <code><%= pr.branch %></code> &rarr; <code><%= pr.target %></code>
<% end %>
</p>

<% if (problem = pr.problem) %>
  <p class="nodata"><%= problem %></p>
<% else %>
  <% commits = pr.commits %>
  <% if commits.empty? %>
    <p class="nodata"><%= pr.branch %> has no commits that aren't on <%= pr.target %>.</p>
  <% else %>
    <p><%= pluralize(commits.size, 'commit') %>
    <% if User.current.allowed_to?(:browse_repository, pr.repository.project) %>
      &middot; <%= link_to 'View the diff',
                           {controller: 'repositories', action: 'diff', id: pr.repository.project,
                            repository_id: pr.repository.identifier_param,
                            rev: pr.tip, rev_to: pr.merge_base} %>
    <% end %>
    </p>
    <table class="list">
      <% commits.each do |c| %>
        <tr>
          <td class="id"><%= link_to_revision(c[:id], pr.repository, text: c[:id][0, 10]) %></td>
          <td class="subject"><%= c[:subject] %></td>
          <td class="author"><%= c[:author] %></td>
          <td class="created_on"><%= c[:date] %></td>
        </tr>
      <% end %>
    </table>
    <% if commits.size >= GitPullRequests::PullRequest::MAX_COMMITS %>
      <p class="nodata">Only the newest <%= commits.size %> commits are listed.</p>
    <% end %>
  <% end %>
<% end %>
</div>
