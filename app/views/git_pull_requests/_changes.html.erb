<% problem = pr.problem %>
<% commits = problem ? [] : pr.commits %>
<hr>
<div class="pull-request-changes">
<% if commits.any? %>
  <%# On the right of the heading, like the links of Subtasks and Related issues %>
  <div class="contextual">
    <%= pluralize(pr.commit_count, 'commit') %>
    <% if User.current.allowed_to?(:browse_repository, pr.repository.project) %>
      &middot; <%= link_to l(:label_view_diff),
                           {controller: 'repositories', action: 'diff', id: pr.repository.project,
                            repository_id: pr.repository.identifier_param,
                            rev: pr.source_tip, rev_to: pr.merge_base} %>
    <% end %>
  </div>
<% end %>
<p><strong><%= l(:label_change_plural) %></strong></p>

<% if problem %>
  <p class="nodata"><%= problem %></p>
<% elsif commits.empty? %>
  <p class="nodata"><%= pr.source %> has no commits that aren't on <%= pr.target %>.</p>
<% else %>
  <table class="list">
    <% commits.each do |c| %>
      <tr>
        <td class="id"><%= link_to_revision(c[:id], pr.repository, text: c[:id][0, 10]) %></td>
        <td class="subject"><%= c[:subject] %></td>
        <td class="author"><%= c[:author] %></td>
        <td class="created_on"><%= c[:date] %></td>
      </tr>
    <% end %>
  </table>
  <% if commits.size < pr.commit_count %>
    <p class="nodata">Only the newest <%= commits.size %> of <%= pr.commit_count %> commits are listed.</p>
  <% end %>
<% end %>
</div>
